{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/scripts/user_prompt_submit.py",
            "timeout": 10,
            "statusMessage": "Checking Cost SOMA policy intent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/scripts/stop_policy_review.py",
            "timeout": 15,
            "statusMessage": "Auditing Cost SOMA policy answer"
          }
        ]
      }
    ]
  }
}
